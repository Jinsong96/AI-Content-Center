# 历史封面图约 13MB，现改为 base64 直存
frontend/covers/

# ---------- 4. 缓存、备份与临时文件 ----------
# 部署注入机制的干净版备份
.deploy_backup/
backend/*.tmp
backend/.article_cache.json
backend/.toutiao_en_cache.json
backend/.content_tags_cache.json
__pycache__/
*.py[cod]
.DS_Store
._*

# ---------- 5. 历史副本与归档（避免真源分叉）----------
frontend_v2/
frontend_original_index_2026-09-03.html
*.zip
*.tar.gz

# ---------- 6. 死资产（89KB，代码中零引用）----------
frontend/hotspots.json

# ---------- 7. 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
