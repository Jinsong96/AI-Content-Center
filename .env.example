# Railway 部署环境变量模板 — 复制到 Railway Dashboard 的 Variables 面板
# 密钥从这里从本地 frontend/config.local.js 复制（不在仓库里、也不上传）。

# 必填：4 个 API 密钥
SF_API_KEY=sk-...           # SiliconFlow：文生图（Kolors）+ LLM（Qwen2.5-7B）
DIFY_WF_FACT=app-...        # Dify 事实抽取工作流的 app key
DIFY_WF_GEN=app-...         # Dify 内容生成工作流的 app key
DIFY_WF_MAIN=app-...        # Dify 主工作流的 app key（如暂未用到，留空即可）

# 可选：演示账号密码（不填 = 老师点登录即可直接进入，无需输密码）
# 变量名必须是 DEMO_PASS，与代码读取的保持一致
DEMO_PASS=123456

# 可选：前端 HTML 路径（一般不用改，bridge 默认找 ../frontend/index.html）
# FRONTEND_HTML=/app/frontend/index.html

# 注意：PORT 由 Railway 自动注入，无需手动设置。